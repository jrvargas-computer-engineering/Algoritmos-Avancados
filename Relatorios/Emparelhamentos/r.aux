\@writefile{lof}{\contentsline {figure}{\numberline {1.8}{\ignorespaces Relaxações de aresta por chamada vs.\ $n$ em escala log-log (W2, JD). Os expoentes empíricos coincidem com a teoria ($k_\text  {emp} \approx \alpha $), confirmando $O(m)$ relaxações por invocação do Dijkstra.}}{19}{figure.caption.13}\protected@file@percent }
\newlabel{fig:w2}{{1.8}{19}{Relaxações de aresta por chamada vs.\ $n$ em escala log-log (W2, JD). Os expoentes empíricos coincidem com a teoria ($k_\text {emp} \approx \alpha $), confirmando $O(m)$ relaxações por invocação do Dijkstra}{figure.caption.13}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.4.8}W3 -- Escalabilidade em Tempo de Parede: BF vs.\ JD}{20}{subsection.CHAPTER.1.4.8}\protected@file@percent }
