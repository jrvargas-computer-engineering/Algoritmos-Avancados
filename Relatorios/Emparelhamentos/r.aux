\newlabel{fig:w3-wallclock}{{1.9}{21}{Tempo de parede (mediana) vs.\ $n$ em escala log-log por $\alpha $ (W3). Banda sombreada: mediana a p90; linhas tracejadas: referências teóricas. Para $\alpha \le 1{,}5$, JD é mais rápido; em $\alpha = 1{,}75$ os tempos praticamente empatam; para $\alpha = 2{,}0$, BF é substancialmente mais rápido}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.10}{\ignorespaces Fator de aceleração (BF / JD) sobre $(n, \alpha )$ (W3). Para $\alpha = 2{,}0$, JD é consistentemente mais lento que BF (speedup $< 1$) em todo o intervalo de $n$.}}{22}{figure.caption.16}\protected@file@percent }
\newlabel{fig:w3-heatmap}{{1.10}{22}{Fator de aceleração (BF / JD) sobre $(n, \alpha )$ (W3). Para $\alpha = 2{,}0$, JD é consistentemente mais lento que BF (speedup $< 1$) em todo o intervalo de $n$}{figure.caption.16}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.4.9}W4 -- Estresse com Pesos Negativos}{22}{subsection.CHAPTER.1.4.9}\protected@file@percent }
